# Django Settings
SECRET_KEY=
# Local development only. Always set DEBUG=False in production.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# En producción: https://tudominio.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ADMIN_DEV_BYPASS=False
ADMIN_LOGIN_TOKEN=
ADMIN_INVITE_CODE=
ADMIN_INVITE_SECRET=
BOOTSTRAP_SUPERUSER_PASSWORD=
BOOTSTRAP_DELEGADOR_PASSWORD=
TEST_ADMIN_PASSWORD=

# Database (for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/canal_denuncias

# Email Configuration
# En producción usa: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Canal de Denuncias <noreply@yourcompany.com>

# SMS Configuration (for 2FA)
SMS_API_KEY=your-sms-api-key
SMS_API_URL=https://api.sms-provider.com/send

# File Upload Settings
MAX_UPLOAD_SIZE=10485760
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.doc,.docx,.txt,.jpg,.jpeg,.png,.gif,.mp4,.mp3,.zip
DATA_UPLOAD_MAX_NUMBER_FIELDS=500

# Proxy confiable (solo si la app corre detrás de un proxy/balanceador)
# Deja USE_X_FORWARDED_FOR=False salvo que exista un proxy confiable delante.
USE_X_FORWARDED_FOR=False
TRUSTED_PROXY_COUNT=1

# API pública (app Android)
# En producción define los orígenes permitidos para CORS (separados por coma).
CORS_ALLOWED_ORIGINS=https://tudominio.com

# HTTPS / seguridad (en producción detrás de un proxy con TLS)
# Sin definir usan los valores seguros por defecto (True cuando DEBUG=False).
# Para probar por HTTP sin proxy (p. ej. Docker local), ponlas en False.
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# Logging
LOG_LEVEL=INFO
LOG_FILE=canal_denuncias.log
